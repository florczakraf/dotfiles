#!/usr/bin/env python3
import json
import sys
import base64
import binascii
from pprint import pprint

def main():
    token = sys.argv[1]
    for part in token.split("."):
        print(part)
        try:
            json_bytes = base64.urlsafe_b64decode(part)
            print(json.dumps(json.loads(json_bytes), indent=2))
        except binascii.Error:
            print("can't decode, most likely a signature?")
        print()

if __name__ == "__main__":
    main()
